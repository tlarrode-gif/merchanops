NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Contraseña inicial del usuario "admin" SOLO para instalaciones nuevas (base vacía).
# Si se omite, la app genera una aleatoria y la muestra una vez por consola.
# AVISO: al ser NEXT_PUBLIC_ queda incrustada en el bundle del navegador. Defínela
# solo durante la instalación inicial y retírala en cuanto el admin tenga contraseña.
NEXT_PUBLIC_INITIAL_ADMIN_PASSWORD=

# URL base de MerchanLOGS, usada para los enlaces cruzados desde el módulo de
# Logística (app/logistica/logistics-client.tsx, .../solicitudes/...-client.tsx).
# Si se deja vacía, el código cae a https://merchanlogs.vercel.app — es decir, un
# despliegue nuevo apuntaría a la MerchanLOGS de producción sin avisar.
NEXT_PUBLIC_MERCHANLOGS_URL=
